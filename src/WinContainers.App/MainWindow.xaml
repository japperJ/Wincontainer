<Window
    x:Class="WinContainers_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Title="WinContainers"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="AiPanelSplitterColumn" Width="0" />
            <ColumnDefinition x:Name="AiPanelColumn" Width="0" MinWidth="220" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ContentRow" Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="BottomContentRow" Height="0" />
        </Grid.RowDefinitions>

        <InfoBar Grid.Row="0"
                 Grid.ColumnSpan="3"
                 x:Name="AdminWarningBar"
                 IsClosable="False"
                 Severity="Warning"
                 Title="Not running as Administrator"
                 Message="Some features (e.g. WSLC operations) may require elevated privileges. Right-click the app and select 'Run as administrator' for full functionality."
                 Visibility="Collapsed" />

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            Grid.Column="0"
            PaneDisplayMode="Left"
            OpenPaneLength="280"
            CompactPaneLength="56"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            SelectionChanged="RootNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home" AutomationProperties.Name="Dashboard" />
                <NavigationViewItem Tag="AI" Icon="Comment" AutomationProperties.Name="AI Assistant">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="AI Assistant" VerticalAlignment="Center" />
                            <Border Background="#FFC107" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="New alpha test" FontSize="10" FontWeight="SemiBold" Foreground="Black" />
                            </Border>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem Content="Terminal" Tag="Terminal" Icon="Document" AutomationProperties.Name="Terminal" AutomationProperties.AutomationId="TerminalNavItem" />
                <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting" AutomationProperties.Name="Settings" />
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Button x:Name="HelpButton" Content="Help &amp; Diagnostics" Click="HelpButton_Click" HorizontalAlignment="Stretch" AutomationProperties.Name="Help and Diagnostics" />
            </NavigationView.PaneFooter>

            <Grid>
                <Frame x:Name="RootFrame" />
                <Button x:Name="ToggleAiPanelButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,10,12,0"
                        Padding="12,8"
                        Click="ToggleAiPanelButton_Click"
                        ToolTipService.ToolTip="Toggle AI assistant panel"
                        AutomationProperties.Name="Toggle AI assistant panel">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8BD;" />
                        <TextBlock x:Name="AiPanelToggleText" Text="AI" />
                    </StackPanel>
                </Button>
            </Grid>
        </NavigationView>

        <Border x:Name="AiPanelResizeGrip"
                Grid.Row="1"
                Grid.Column="1"
                Width="16"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed"
                Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                Opacity="0.15"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                PointerPressed="AiPanelResizeGrip_PointerPressed"
                PointerMoved="AiPanelResizeGrip_PointerMoved"
                PointerReleased="AiPanelResizeGrip_PointerReleased" />

        <Border x:Name="AiPanelHost"
                Grid.Row="1"
                Grid.Column="2"
                Width="0"
                Visibility="Collapsed"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
            <Frame x:Name="AiPanelFrame" />
        </Border>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Height="8" Background="Transparent" x:Name="OutputSplitter" PointerPressed="OutputSplitter_PointerPressed" PointerMoved="OutputSplitter_PointerMoved" PointerReleased="OutputSplitter_PointerReleased">
            <Rectangle Height="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.6" />
        </Grid>

        <Grid Grid.Row="3" Grid.ColumnSpan="2" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Output" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" x:Name="LogLevelFilter" SelectedIndex="0" SelectionChanged="LogLevelFilter_SelectionChanged" MinWidth="90">
                <x:String>All</x:String>
                <x:String>Info</x:String>
                <x:String>Warnings</x:String>
            </ComboBox>
            <TextBlock Grid.Column="2" x:Name="OutputTabText" Text="Ready" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="3" x:Name="ClearOutputButton" Content="Clear" Click="ClearOutputButton_Click" AutomationProperties.Name="Clear output" />
            <Button Grid.Column="4" x:Name="ToggleBottomPaneButton" Content="Output" Click="ToggleBottomPaneButton_Click" ToolTipService.ToolTip="Toggle output pane" AutomationProperties.Name="Toggle output pane" />
        </Grid>

        <ScrollViewer Grid.Row="4" Grid.ColumnSpan="2" x:Name="OutputScrollViewer" Background="{ThemeResource LayerFillColorAltBrush}" Visibility="Collapsed">
            <TextBlock x:Name="OutputTextBlock" Padding="12,4" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" />
        </ScrollViewer>
    </Grid>
</Window>
