<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinContainers_App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinContainers_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Container detail actions bar (visible only when detail tab is active) -->
        <Border x:Name="ContainerActionsBar" Grid.Row="0" Padding="16,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="DetailBackButton_Click" AutomationProperties.Name="Back to containers" ToolTipService.ToolTip="Back to containers">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailContainerName" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Container name" />
                </StackPanel>

                <Border x:Name="DetailStatusBadge" Grid.Column="2" Padding="8,2,8,2" VerticalAlignment="Center" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left">
                    <TextBlock x:Name="DetailStatusText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>

                <StackPanel x:Name="DetailActionsPanel" Grid.Column="3" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="DetailStartButton" Content="Start" Click="DetailStartButton_Click" AutomationProperties.Name="Start container" />
                    <Button x:Name="DetailStopButton" Content="Stop" Click="DetailStopButton_Click" AutomationProperties.Name="Stop container" />
                    <Button x:Name="DetailRestartButton" Content="Restart" Click="DetailRestartButton_Click" AutomationProperties.Name="Restart container" />
                    <Button x:Name="DetailDeleteButton" Content="Delete" Click="DetailDeleteButton_Click" AutomationProperties.Name="Delete container" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="24,16,24,0">
            <Grid>
                <local:OverviewControl x:Name="OverviewContent" Visibility="Visible" />
                <local:ContainersControl x:Name="ContainersContent" Visibility="Collapsed" />
                <local:ImagesPage x:Name="ImagesContent" Visibility="Collapsed" />
                <local:QuickActionsControl x:Name="QuickActionsContent" Visibility="Collapsed" />
                <local:TemplateCatalogControl x:Name="TemplateCatalogContent" Visibility="Collapsed" />
                <local:ComposeControl x:Name="ComposeContent" Visibility="Collapsed" />
                <local:ResourcesControl x:Name="VolumesContent" Visibility="Collapsed" ResourceType="Volumes" />
                <local:ResourcesControl x:Name="NetworksContent" Visibility="Collapsed" ResourceType="Networks" />
                <ContentControl x:Name="DetailContent" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>
        </Border>
    </Grid>
</Page>
