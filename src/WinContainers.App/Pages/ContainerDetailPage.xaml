<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinContainers_App.Pages.ContainerDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WinContainers_App.ViewModels"
    xmlns:models="using:WinContainers.Runtime.Models"
    xmlns:converters="using:WinContainers_App.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:PermissionsToNumericConverter x:Key="PermissionsToNumericConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Back" Click="BackButton_Click" AutomationProperties.Name="Back" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.ContainerName, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Container name" />
                </StackPanel>

                <Border Grid.Column="2" Padding="8,2,8,2" VerticalAlignment="Center" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="{x:Bind ViewModel.ContainerStatus, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" IsEnabled="{x:Bind ViewModel.IsStartEnabled, Mode=OneWay}" AutomationProperties.Name="Start container" />
                    <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" IsEnabled="{x:Bind ViewModel.IsStopEnabled, Mode=OneWay}" AutomationProperties.Name="Stop container" />
                    <Button x:Name="RestartButton" Content="Restart" Click="RestartButton_Click" IsEnabled="{x:Bind ViewModel.IsRestartEnabled, Mode=OneWay}" AutomationProperties.Name="Restart container" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" IsEnabled="{x:Bind ViewModel.IsDeleteEnabled, Mode=OneWay}" AutomationProperties.Name="Delete container" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Info bar -->
        <Border Grid.Row="1" Padding="16,6" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="{x:Bind ViewModel.ContainerInfo, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Container info" />
        </Border>

        <!-- Action error -->
        <InfoBar Grid.Row="2" Severity="Error" Message="{x:Bind ViewModel.ActionError, Mode=OneWay}" IsOpen="{x:Bind ViewModel.HasActionError, Mode=OneWay}" IsClosable="True" CloseButtonClick="ActionErrorInfoBar_CloseButtonClick" Padding="12,6" />

        <!-- Tab content -->
        <Pivot Grid.Row="3" x:Name="DetailPivot" Padding="0" Margin="0">
            <!-- Logs Tab -->
            <PivotItem Header="Logs">
                <Grid Padding="16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button x:Name="RefreshLogsButton" Content="Refresh" Click="RefreshLogsButton_Click" AutomationProperties.Name="Refresh logs" />
                        <TextBlock Text="{x:Bind ViewModel.LogsInfoText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" AutomationProperties.Name="Logs info" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" x:Name="LogsScrollViewer" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <TextBlock Text="{x:Bind ViewModel.LogsContent, Mode=OneWay}" FontFamily="Consolas" FontSize="12" Padding="12,8" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.Name="Container logs" />
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <!-- Inspect Tab -->
            <PivotItem Header="Inspect">
                <Grid Padding="16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button x:Name="RefreshInspectButton" Content="Refresh" Click="RefreshInspectButton_Click" AutomationProperties.Name="Refresh inspect" />
                        <Button x:Name="CopyInspectButton" Content="Copy JSON" Click="CopyInspectButton_Click" AutomationProperties.Name="Copy inspect JSON" />
                        <TextBlock Text="{x:Bind ViewModel.InspectStatusText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" AutomationProperties.Name="Inspect status" />
                    </StackPanel>

                    <Grid Grid.Row="1" x:Name="InspectContainer" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                </Grid>
            </PivotItem>

            <!-- Shell Tab -->
            <PivotItem Header="Shell">
                <Grid Padding="16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <ComboBox x:Name="ShellSelector" SelectedIndex="{x:Bind ViewModel.ShellSelectorIndex, Mode=TwoWay}" MinWidth="120" AutomationProperties.Name="Shell selector">
                            <x:String>/bin/bash</x:String>
                            <x:String>/bin/sh</x:String>
                            <x:String>pwsh</x:String>
                            <x:String>cmd.exe</x:String>
                        </ComboBox>
                        <Button x:Name="ClearShellButton" Content="Clear" Click="ClearShellButton_Click" AutomationProperties.Name="Clear shell output" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" x:Name="ShellScrollViewer" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <TextBlock Text="{x:Bind ViewModel.ShellOutput, Mode=OneWay}" FontFamily="Consolas" FontSize="12" Padding="12,8" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.Name="Shell output" />
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="0,8,0,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="ShellCommandBox" PlaceholderText="Enter command..." AcceptsReturn="False" KeyUp="ShellCommandBox_KeyUp" Text="{x:Bind ViewModel.ShellCommand, Mode=TwoWay}" AutomationProperties.Name="Shell command input" />
                            <Button Grid.Column="1" x:Name="ShellRunButton" Content="Run" Click="ShellRunButton_Click" IsEnabled="{x:Bind ViewModel.IsShellRunning, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" AutomationProperties.Name="Run shell command" />
                        </Grid>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- Files Tab -->
            <PivotItem Header="Files">
                <Grid Padding="16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Breadcrumb + import + refresh -->
                    <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="BreadcrumbItems" ItemsSource="{x:Bind ViewModel.BreadcrumbSegments, Mode=OneWay}" AutomationProperties.Name="File path breadcrumb">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" Padding="2,0" ToolTipService.ToolTip="Navigate to this directory" />
                                            <TextBlock Grid.Column="1" Text="/" VerticalAlignment="Center" Margin="2,0,0,0" Opacity="0.6" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Grid.Column="1" x:Name="ImportFileButton" Content="Import" Click="ImportFileButton_Click" IsEnabled="{x:Bind ViewModel.IsImportEnabled, Mode=OneWay}" ToolTipService.ToolTip="Import file to this directory" AutomationProperties.Name="Import file" />
                        <Button Grid.Column="2" x:Name="RefreshFilesButton" Content="Refresh" Click="RefreshFilesButton_Click" IsEnabled="{x:Bind ViewModel.IsRefreshFilesEnabled, Mode=OneWay}" AutomationProperties.Name="Refresh files" />
                    </Grid>

                    <!-- File list panel -->
                    <Grid Grid.Row="1" x:Name="FileListPanel">
                        <TextBlock Text="{x:Bind ViewModel.FilesLoadingText, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ViewModel.IsFilesLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" AutomationProperties.Name="Files loading status" />
                        <ListView ItemsSource="{x:Bind ViewModel.FileEntries, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="FileListView_ItemClick" Visibility="{x:Bind ViewModel.ShowFileList, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" RightTapped="FileListView_RightTapped" AutomationProperties.Name="File list">
                             <ListView.ItemTemplate>
                                 <DataTemplate x:DataType="models:FileEntryData">
                                     <Grid Padding="8,4" ColumnSpacing="8">
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="Auto" />
                                         </Grid.ColumnDefinitions>
                                         <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                         <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"> 
                                             <Run Text="{Binding Permissions}" />
                                             <Run Text=" / " />
                                             <Run Text="{Binding Permissions, Converter={StaticResource PermissionsToNumericConverter}}" />
                                         </TextBlock>
                                     </Grid>
                                 </DataTemplate>
                             </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- File content viewer -->
                    <Grid Grid.Row="1" x:Name="FileContentPanel" Visibility="{x:Bind ViewModel.ShowFileContent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button Content="Back" Click="FileViewerBack_Click" AutomationProperties.Name="Back to file list" />
                            <Button x:Name="FileViewerEditButton" Content="Edit" Click="FileViewerEditButton_Click" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" AutomationProperties.Name="Edit file" />
                            <Button x:Name="FileViewerSaveButton" Content="Save" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Click="FileViewerSaveButton_Click" AutomationProperties.Name="Save file" />
                            <Button x:Name="FileViewerCancelButton" Content="Cancel" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Click="FileViewerCancelButton_Click" AutomationProperties.Name="Cancel editing" />
                            <Button x:Name="FileViewerExportButton" Content="Export" Click="FileViewerExportButton_Click" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" AutomationProperties.Name="Export file" />
                            <Button x:Name="FileViewerDeleteButton" Content="Delete" Click="FileViewerDeleteButton_Click" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" AutomationProperties.Name="Delete file" />
                            <TextBlock Text="{x:Bind ViewModel.ViewingFilePath, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.Name="File path" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                            <Grid>
                                <TextBlock Text="{x:Bind ViewModel.FileContent, Mode=OneWay}" FontFamily="Consolas" FontSize="12" Padding="12,8" IsTextSelectionEnabled="True" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" AutomationProperties.Name="File content" />
                                <TextBox Text="{x:Bind ViewModel.FileEditContent, Mode=TwoWay}" FontFamily="Consolas" FontSize="12" Padding="12,8" AcceptsReturn="True" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" BorderThickness="0" AutomationProperties.Name="File content editor" />
                                <TextBlock Text="This file appears to be binary. Use Export to download it." FontSize="14" Padding="24,16" Visibility="{x:Bind ViewModel.IsFileBinary, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
