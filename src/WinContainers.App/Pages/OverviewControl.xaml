<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinContainers_App.Pages.OverviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Spacing="16">
            <Border Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="16">
                    <Grid>
                        <TextBlock Text="Runtime status" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Live overview" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Padding="12" CornerRadius="10"
                                Background="{ThemeResource LayerFillColorAltBrush}">
                            <Grid ColumnSpacing="10">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                         Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                         VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Service" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="StatusText" Text="Checking..." Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Padding="12" CornerRadius="10"
                                Background="{ThemeResource LayerFillColorAltBrush}">
                            <Grid ColumnSpacing="10">
                                <Ellipse Width="10" Height="10" Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                         VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="WSLC runtime" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="WslcVersionText" Text="WSLC: --" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Padding="12" CornerRadius="10"
                                Background="{ThemeResource LayerFillColorAltBrush}">
                            <Grid ColumnSpacing="10">
                                <Ellipse Width="10" Height="10" Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                         VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Containers" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="ContainerCountText" Text="Containers: --" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Padding="12" CornerRadius="10"
                                Background="{ThemeResource LayerFillColorAltBrush}">
                            <Grid ColumnSpacing="10">
                                <Ellipse Width="10" Height="10" Fill="{ThemeResource SystemFillColorAttentionBrush}"
                                         VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Activity" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="RunningCountText" Text="Running: --" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="ImageCountText" Text="Images: --" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Padding="12" CornerRadius="10"
                                Background="{ThemeResource LayerFillColorAltBrush}">
                            <Grid ColumnSpacing="10">
                                <Ellipse x:Name="McpStatusDot" Width="10" Height="10"
                                         Fill="{ThemeResource SystemFillColorAttentionBrush}"
                                         VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="MCP server" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="McpStatusText" Text="Checking..." Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="1" Padding="12" CornerRadius="10"
                                Background="{ThemeResource LayerFillColorAltBrush}">
                            <Grid ColumnSpacing="10">
                                <Ellipse x:Name="ApiStatusDot" Width="10" Height="10"
                                         Fill="{ThemeResource SystemFillColorAttentionBrush}"
                                         VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Remote API access" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="ApiStatusText" Text="Checking..." Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed" x:Name="SetupHintCard">
                <StackPanel Spacing="12">
                    <TextBlock Text="Getting started" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="WSLC runtime is not available yet." TextWrapping="Wrap" />
                    <TextBlock x:Name="SetupHintText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
