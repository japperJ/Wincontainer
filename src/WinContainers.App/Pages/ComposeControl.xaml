<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinContainers_App.Pages.ComposeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:WinContainers_App.ViewModels">

    <Grid Padding="24,16,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Compose" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Paste Compose YAML or a docker run command, preview parsed services, and create the full stack when ready." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Row="1" Content="Parse &amp; preview" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="ParseComposeButton_Click" AutomationProperties.Name="Parse compose YAML" AutomationProperties.AutomationId="ParseComposeButton" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="360" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border Padding="16" CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="YAML input" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox
                        x:Name="ComposeTextBox"
                        Grid.Row="1"
                        MinHeight="420"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="services:&#x0a;  myservice:&#x0a;    image: n8n/n8n&#x0a;    ports:&#x0a;      - &quot;5678:5678&quot;"
                        Text="{Binding ComposeYamlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Compose YAML paste"
                        AutomationProperties.AutomationId="ComposeYamlTextBox" />
                </Grid>
            </Border>

            <controls:GridSplitter Grid.Column="1" ResizeBehavior="BasedOnAlignment" ResizeDirection="Columns" Background="{ThemeResource DividerStrokeColorDefaultBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Resize compose preview" AutomationProperties.AutomationId="ComposePreviewGridSplitter" />

            <Grid Grid.Column="2" Margin="16,0,0,0">
                <Border x:Name="EmptyPreviewPanel" Padding="16" CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Preview" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Parsed services and conflict warnings appear here before anything is created." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ComposePreviewPanel" Visibility="Collapsed" Padding="16" CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Preview" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Review the parsed stack and resolve any warnings before creating services." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBox Grid.Row="1" Header="Project name (for grouping)" PlaceholderText="e.g. n8n-stack" Text="{Binding ProjectNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Compose project name" AutomationProperties.AutomationId="ComposeProjectNameTextBox" />

                        <InfoBar Grid.Row="2" Severity="Warning" IsOpen="{Binding HasConflicts, Mode=OneWay}" Message="{Binding ConflictSummary, Mode=OneWay}" IsClosable="False">
                            <InfoBar.Content>
                                <ItemsControl ItemsSource="{Binding ConflictWarnings, Mode=OneWay}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </InfoBar.Content>
                        </InfoBar>

                        <ScrollViewer Grid.Row="3">
                            <ItemsControl ItemsSource="{Binding ParsedServices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:ParsedServiceConfig">
                                        <Border Padding="12" Margin="0,0,0,8" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind ContainerName, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Summary, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="4" Content="Create all services" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="CreateAllButton_Click" AutomationProperties.Name="Create all compose services" AutomationProperties.AutomationId="CreateAllComposeServicesButton" />
                        <TextBlock Grid.Row="5" Text="Create All opens the output pane and processes each parsed service one at a time." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
