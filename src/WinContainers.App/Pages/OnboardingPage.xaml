<Page
    x:Class="WinContainers_App.Pages.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24">
        <StackPanel MaxWidth="800" HorizontalAlignment="Center" Spacing="24">
            <!-- Header -->
            <TextBlock
                Text="Welcome to WinContainers"
                Style="{StaticResource TitleTextBlockStyle}"
                TextWrapping="Wrap" />
            <TextBlock
                Text="Let's set up the prerequisites for running Linux containers on Windows."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <!-- Windows Version Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Glyph="&#xE777;"
                        FontSize="24"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource SystemAccentColor}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Windows Version" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="WindowsVersionStatus"
                            Text="Checking..."
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <FontIcon
                        Grid.Column="2"
                        x:Name="WindowsVersionIcon"
                        Glyph="&#xE73E;"
                        FontSize="20"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Virtualization Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Glyph="&#xE70C;"
                        FontSize="24"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource SystemAccentColor}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Virtualization" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="VirtualizationStatus"
                            Text="Checking..."
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <FontIcon
                        Grid.Column="2"
                        x:Name="VirtualizationIcon"
                        Glyph="&#xE73E;"
                        FontSize="20"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- WSL2 Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Glyph="&#xE7B4;"
                        FontSize="24"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource SystemAccentColor}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="WSL2 (Windows Subsystem for Linux)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="Wsl2Status"
                            Text="Checking..."
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        x:Name="InstallWsl2Button"
                        Content="Install"
                        Click="InstallWsl2_Click"
                        Visibility="Collapsed"
                        VerticalAlignment="Center" />
                    <FontIcon
                        Grid.Column="2"
                        x:Name="Wsl2Icon"
                        Glyph="&#xE73E;"
                        FontSize="20"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- WSLC Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Glyph="&#xE774;"
                        FontSize="24"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource SystemAccentColor}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="WSLC (WSL Containers)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="WslcStatus"
                            Text="Checking..."
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        x:Name="InstallWslcButton"
                        Content="Install"
                        Click="InstallWslc_Click"
                        Visibility="Collapsed"
                        VerticalAlignment="Center" />
                    <FontIcon
                        Grid.Column="2"
                        x:Name="WslcIcon"
                        Glyph="&#xE73E;"
                        FontSize="20"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Progress indicator -->
            <ProgressRing
                x:Name="ProgressIndicator"
                IsActive="False"
                Width="32"
                Height="32"
                HorizontalAlignment="Center"
                Visibility="Collapsed" />

            <!-- Install progress text -->
            <TextBlock
                x:Name="InstallProgressText"
                Text=""
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                Visibility="Collapsed" />

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <Button
                    x:Name="CheckAgainButton"
                    Content="Check Again"
                    Click="CheckAgain_Click"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    x:Name="ContinueButton"
                    Content="Continue to App"
                    Click="Continue_Click"
                    IsEnabled="False"
                    Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
