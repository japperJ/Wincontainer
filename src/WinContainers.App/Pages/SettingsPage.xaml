<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinContainers_App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="24">
            <Border Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

                    <TextBox x:Name="PortBox" Header="API Port" PlaceholderText="5123" Width="200" />
                    <Button Content="Apply" Click="ApplyPortButton_Click" />

                    <TextBox x:Name="TokenBox" Header="API Bearer Token" PlaceholderText="Leave empty to disable auth" Width="300" />
                    <Button Content="Apply Token" Click="ApplyTokenButton_Click" />

                    <ToggleSwitch x:Name="ApiLoggingToggle"
                                  Header="API request logging"
                                  OffContent="Off"
                                  OnContent="On"
                                  Toggled="ApiLoggingToggle_Toggled" />

                    <ToggleSwitch x:Name="RemoteApiLoggingToggle"
                                  Header="Remote API calls only"
                                  OffContent="All"
                                  OnContent="Remote"
                                  Toggled="RemoteApiLoggingToggle_Toggled" />

                    <StackPanel Spacing="4">
                        <ToggleSwitch x:Name="AllowRemoteApiToggle"
                                      Header="Allow remote API access"
                                      OffContent="Blocked"
                                      OnContent="Allowed"
                                      Toggled="AllowRemoteApiToggle_Toggled" />
                        <TextBlock Text="Local requests always work. Turn off to block external clients."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock x:Name="EndpointText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="MCP Server" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <StackPanel Spacing="4">
                        <ToggleSwitch x:Name="McpEnabledToggle"
                                      Header="MCP server"
                                      OffContent="Off"
                                      OnContent="On"
                                      Toggled="McpEnabledToggle_Toggled" />
                        <TextBlock Text="When off, external MCP clients receive 404. The in-app AI chat is not affected."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <ToggleSwitch x:Name="McpLoggingToggle"
                                      Header="MCP request logging"
                                      OffContent="Off"
                                      OnContent="On"
                                      Toggled="McpLoggingToggle_Toggled" />
                        <TextBlock Text="Logs MCP activity (methods, tool calls and their results) to the Output window."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="AI Assistant" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <ComboBox x:Name="AiProviderBox" Header="Provider" SelectedValuePath="Tag" Width="240">
                        <ComboBoxItem Content="OpenAI-compatible endpoint" Tag="OpenAiCompatible" />
                        <ComboBoxItem Content="Local Ollama" Tag="Ollama" />
                    </ComboBox>
                    <TextBox x:Name="AiEndpointBox" Header="Endpoint" PlaceholderText="https://api.openai.com/v1" Width="380" />
                    <TextBox x:Name="AiModelBox" Header="Model" PlaceholderText="gpt-4o-mini" Width="240" />
                    <PasswordBox x:Name="AiKeyBox" Header="API key" PlaceholderText="sk-... (leave empty for Ollama)" Width="380" />

                    <ToggleSwitch x:Name="AiConfirmToggle"
                                  Header="Require confirmation for destructive actions"
                                  OffContent="Off"
                                  OnContent="On" />

                    <Button Content="Save AI settings" Click="SaveAiSettingsButton_Click" />
                    <TextBlock x:Name="AiStatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Runtime Status" Style="{StaticResource SubtitleTextBlockStyle}" />

                     <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Row="0" x:Name="ServiceDot" Width="12" Height="12" Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ServiceStatusText" Text="Checking..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                         <TextBlock Grid.Row="1" Grid.Column="1" x:Name="VersionText" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                     </Grid>

                     <StackPanel Spacing="8">
                        <TextBlock Text="WinContainers Updates" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Version" />
                        <TextBlock x:Name="AppVersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="UpdateChannelBox" Header="Update channel" SelectedValuePath="Tag" SelectionChanged="UpdateChannelBox_SelectionChanged" Width="220">
                            <ComboBoxItem Content="Stable" Tag="stable" />
                            <ComboBoxItem Content="Beta" Tag="beta" />
                        </ComboBox>
                        <TextBlock x:Name="AppUpdateStatusText" Text="Use Check for updates to look for a newer WinContainers release." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckAppUpdateButton" Content="Check for updates" Click="CheckAppUpdateButton_Click" />
                            <Button x:Name="InstallAppUpdateButton" Content="Download and Install" Click="InstallAppUpdateButton_Click" IsEnabled="False" />
                            <Button x:Name="DeferAppUpdateButton" Content="Later" Click="DeferAppUpdateButton_Click" IsEnabled="False" />
                        </StackPanel>
                     </StackPanel>

                     <StackPanel Spacing="8">
                        <TextBlock Text="WSLC Updates" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="WslcUpdateStatusText" Text="Use Check for updates to look for a newer WSLC release." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckWslcUpdateButton" Content="Check for updates" Click="CheckWslcUpdateButton_Click" />
                            <Button x:Name="UpdateWslcButton" Content="Update WSLC" Click="UpdateWslcButton_Click" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
