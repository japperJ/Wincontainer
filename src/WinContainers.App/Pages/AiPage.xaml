<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinContainers_App.Pages.AiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinContainers_App.Models"
    xmlns:local="using:WinContainers_App.Pages"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="UserMessageTemplate" x:DataType="models:UserChatMessage">
            <Border MaxWidth="560" HorizontalAlignment="Right" Margin="0,2,0,8"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="12" Padding="12,8">
                <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" Foreground="White"
                           IsTextSelectionEnabled="True" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate" x:DataType="models:AssistantChatMessage">
            <Border MaxWidth="720" HorizontalAlignment="Left" Margin="0,2,0,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="12,8">
                <TextBlock x:Name="AssistantText" Text="{x:Bind Text, Mode=OneWay}"
                           TextWrapping="Wrap" Loaded="AssistantText_Loaded"
                           IsTextSelectionEnabled="True" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StepCardTemplate" x:DataType="models:StepCardMessage">
            <Border MaxWidth="620" HorizontalAlignment="Left" Margin="0,2,0,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="12,8">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="14"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind Preview}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <ScrollViewer MaxHeight="220" Visibility="{x:Bind OutputVisibility, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Output, Mode=OneWay}" FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SystemMessageTemplate" x:DataType="models:SystemChatMessage">
            <TextBlock Text="{x:Bind Text}" HorizontalAlignment="Center" Margin="0,4"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       IsTextSelectionEnabled="True" />
        </DataTemplate>

        <DataTemplate x:Key="RetryWaitTemplate" x:DataType="models:RetryWaitChatMessage">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,4">
                <FontIcon Glyph="&#xE823;" FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextSelectionEnabled="True" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ThinkingTemplate" x:DataType="models:ThinkingChatMessage">
            <Border MaxWidth="200" HorizontalAlignment="Left" Margin="0,2,0,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="12,8"
                    AutomationProperties.Name="AI is thinking">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="True" Width="16" Height="16" />
                    <TextBlock Text="AI is thinking..." VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <local:MessageTemplateSelector x:Key="MessageTemplateSelector"
                                       UserTemplate="{StaticResource UserMessageTemplate}"
                                       AssistantTemplate="{StaticResource AssistantMessageTemplate}"
                                       StepTemplate="{StaticResource StepCardTemplate}"
                                       SystemTemplate="{StaticResource SystemMessageTemplate}"
                                       RetryWaitTemplate="{StaticResource RetryWaitTemplate}"
                                       ThinkingTemplate="{StaticResource ThinkingTemplate}" />
    </Page.Resources>

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="AI Assistant" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="ProviderStatusText" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" IsEnabled="False" />
            <Button Grid.Column="3" x:Name="CopyButton" Content="Copy" Click="CopyButton_Click" IsEnabled="False" />
            <Button Grid.Column="4" x:Name="SettingsButton" Content="Configure" Click="SettingsButton_Click" />
        </Grid>

        <ListView Grid.Row="1" x:Name="MessageList"
                  ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                  SelectionMode="None"
                  HorizontalContentAlignment="Stretch" />

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputBox" Grid.Column="0" PlaceholderText="Ask me to manage your containers..."
                     TextWrapping="Wrap" AcceptsReturn="False"
                     KeyDown="InputBox_KeyDown" TextChanged="InputBox_TextChanged"
                     AutomationProperties.Name="AI message input" />
            <Button x:Name="SendButton" Grid.Column="1" Content="Send" Click="SendButton_Click"
                    Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
            <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Click="CancelButton_Click"
                    Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
