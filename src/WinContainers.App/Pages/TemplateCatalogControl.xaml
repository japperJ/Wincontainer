<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinContainers_App.Pages.TemplateCatalogControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinContainers_App.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Spacing="16" Padding="24,16,24,24">
            <StackPanel Spacing="4">
                <TextBlock Text="Template Catalog" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Find a single-container template, review its defaults, and load it into Create Container." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Browse templates" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Button x:Name="RefreshCatalogButton" Content="↻ Refresh" MinWidth="80" Height="28" CornerRadius="14" Click="RefreshCatalogButton_Click" FontSize="12" AutomationProperties.Name="Refresh template catalog" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Categories}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Click="CategoryChip_Click" MinWidth="60" Height="32" CornerRadius="16" AutomationProperties.Name="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Header="Search templates" PlaceholderText="Filter by name, category, image..." Text="{Binding TemplateCatalogSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search template catalog" />
                    <ListView x:Name="TemplateCatalogList" ItemsSource="{Binding TemplateCatalog}" Height="360" SelectionMode="Single" SelectionChanged="TemplateCatalogList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" CornerRadius="10" Margin="0,0,0,4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{Binding Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Image}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" FontFamily="Consolas" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border x:Name="TemplateDetailsPanel" Visibility="Collapsed" Padding="20" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Selected template" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="TemplateNameText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="TemplateDescriptionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="TemplateSummaryText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Use template" Style="{StaticResource AccentButtonStyle}" Click="UseTemplateButton_Click" AutomationProperties.Name="Use selected template" />
                        <HyperlinkButton x:Name="WebsiteButton" Content="Open website" AutomationProperties.Name="Open template website" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
